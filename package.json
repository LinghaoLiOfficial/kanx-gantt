{
  "name": "kanx-gantt",
  "version": "0.1.1-rc.0",
  "private": false,
  "description": "A React Gantt chart component with business-friendly task and dependency data.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:lib"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@svar-ui/react-gantt": "2.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "~16.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.2.12",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
